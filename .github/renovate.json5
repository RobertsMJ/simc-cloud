{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  packageRules: [
    {
      matchFileNames: [
        ".github/workflows/**",
        "backend/go.mod",
        "backend/Dockerfile"
      ],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
    },
  ],
}
