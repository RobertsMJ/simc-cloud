{
    "yaml.schemas": {
        "https://raw.githubusercontent.com/rancher/k3d/main/pkg/config/config.versions.schema.json": "file:///${workspaceFolder}/.cluster/k3d.yaml"
    },
    "gopls": {
        "ui.semanticTokens": true,
    },
    "[gotmpl]": {
        "editor.indentSize": 2
    },
    "files.associations": {
        "chart/**/*.yaml": "helm-template",
        "chart/**/*.tpl": "helm-template"
    }
}